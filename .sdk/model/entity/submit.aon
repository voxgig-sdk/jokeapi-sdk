# Entity: submit

main: kit: entity: submit: {

  alias: field: {}

  fields: [
    {
      name: "category"
      req: true
      type: "`$STRING`"
    }
    {
      name: "delivery"
      req: false
      short: "The delivery/punchline (for twopart jokes only)"
      type: "`$STRING`"
    }
    {
      name: "error"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "flags"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "formatVersion"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "joke"
      req: false
      short: "The joke content (for single-type jokes only)"
      type: "`$STRING`"
    }
    {
      name: "lang"
      req: true
      short: "Language code (ISO 639-1)"
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      type: "`$STRING`"
    }
    {
      name: "setup"
      req: false
      short: "The setup part (for twopart jokes only)"
      type: "`$STRING`"
    }
    {
      name: "timestamp"
      req: false
      short: "13-character UNIX timestamp"
      type: "`$INTEGER`"
    }
    {
      name: "type"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "submit"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "dry_run"
                orig: "dry_run"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "json"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/submit"
          parts: [
            "submit"
          ]
          select: {
            exist: [
              "dry_run"
              "format"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
